# Copy to `.env.local` and fill in real values. NEVER commit real values.
# Server-only secrets — do NOT prefix these with NEXT_PUBLIC_.

# MongoDB connection string (MongoDB Atlas free M0 tier, or a local mongod).
# Example: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/bookleaf?retryWrites=true&w=majority
MONGODB_URI=

# Session signing secret — long random string (>= 16 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session lifetime
JWT_EXPIRES_IN=7d

# Public base URL (used in docs/links)
APP_URL=http://localhost:3000

# --- AI (optional; the app degrades gracefully without it) ---
# OpenRouter API key — https://openrouter.ai/keys
# Leave empty to force the deterministic rule-based fallback
# (keyword classification + heuristic priority + template draft).
OPENROUTER_API_KEY=
# Any OpenRouter model id. The ":free" suffix targets models on the free tier.
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set to false to force the rule-based path (useful for offline demos).
AI_ENABLED=true
